<Window
    x:Class="Lynx.Operator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lynx Operator — Prototype 0.5">

    <Grid RequestedTheme="Dark" Background="#0B1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#111827"
                BorderBrush="#263244"
                BorderThickness="0,0,0,1"
                Padding="14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Load Floorplan"
                        Click="LoadFloorplan_Click"/>

                <Button Grid.Column="1"
                        Content="Pan"
                        Click="PanMode_Click"/>

                <Button Grid.Column="2"
                        Content="Calibrate"
                        Click="CalibrationMode_Click"/>

                <Button Grid.Column="3"
                        Content="Place Marker"
                        Click="MarkerMode_Click"/>

                <TextBlock Grid.Column="5"
                           Text="Zoom"
                           VerticalAlignment="Center"/>
                <Slider Grid.Column="6"
                        x:Name="ZoomSlider"
                        Minimum="0.5"
                        Maximum="5"
                        Value="1"
                        StepFrequency="0.1"
                        ValueChanged="ZoomSlider_ValueChanged"/>

                <TextBlock Grid.Column="7"
                           Text="Relay"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="8"
                         x:Name="RelayHostBox"
                         Width="150"
                         Text="127.0.0.1"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="10"
                           Text="Port"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Column="11"
                         x:Name="RelayPortBox"
                         Width="86"
                         Text="7777"
                         VerticalContentAlignment="Center"/>

                <StackPanel Grid.Column="12"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right">
                    <Button Content="Auto"
                            Click="AutoRelay_Click"/>
                    <Button Content="Connect"
                            Click="ConnectRelay_Click"/>
                    <Button Content="Disconnect"
                            Click="DisconnectRelay_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#070D18"
                    BorderBrush="#263244"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid x:Name="ViewportHost"
                      SizeChanged="ViewportHost_SizeChanged"
                      PointerPressed="ViewportHost_PointerPressed"
                      PointerMoved="ViewportHost_PointerMoved"
                      PointerReleased="ViewportHost_PointerReleased"
                      PointerCanceled="ViewportHost_PointerReleased"
                      PointerWheelChanged="ViewportHost_PointerWheelChanged">

                    <Canvas x:Name="FloorplanSurface">
                        <Canvas.RenderTransform>
                            <CompositeTransform x:Name="FloorplanRenderTransform"/>
                        </Canvas.RenderTransform>

                        <Image x:Name="FloorplanImage"
                               Canvas.Left="0"
                               Canvas.Top="0"
                               Stretch="Fill"/>
                    </Canvas>

                    <StackPanel x:Name="EmptyFloorplanPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="No floorplan loaded"
                                   FontSize="24"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Load a PNG or JPEG to begin Prototype 0.5."
                                   Foreground="#94A3B8"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="12"
                            Padding="10,6"
                            Background="#CC111827"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="ModeText"
                                       Text="MODE: PAN"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="CursorText"
                                       Text="PIXEL --   SHARED --"
                                       FontSize="12"
                                       Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border Background="#111827"
                            BorderBrush="#263244"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Relay / State"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ConnectionText"
                                       Text="Disconnected"
                                       Foreground="#F59E0B"/>
                            <TextBlock x:Name="ClientIdText"
                                       Text="Client --"
                                       FontFamily="Consolas"/>
                            <TextBlock x:Name="RelayEndpointText"
                                       Text="Relay --"
                                       FontFamily="Consolas"/>
                            <TextBlock x:Name="VersionText"
                                       Text="Epoch 0 / Version 0"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111827"
                            BorderBrush="#263244"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Floorplan Calibration"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="Known +X distance (metres)"/>
                            <TextBox x:Name="CalibrationDistanceBox"
                                     Text="1.0"/>

                            <TextBlock x:Name="CalibrationInstructionText"
                                       Text="Not calibrated."
                                       TextWrapping="Wrap"
                                       Foreground="#93C5FD"/>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Start / Reset"
                                        Click="StartCalibration_Click"/>
                                <Button Content="Clear"
                                        Click="ClearCalibration_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="CalibrationResultText"
                                       Text="Origin --&#x0a;+X --&#x0a;+Z --&#x0a;Scale --"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111827"
                            BorderBrush="#263244"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Authoritative Markers"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Markers are drawn from relay shared coordinates, not remembered mouse positions."
                                       TextWrapping="Wrap"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>

                            <ListView x:Name="MarkerList"
                                      Height="250"/>

                            <Button Content="Remove Selected Marker"
                                    Click="RemoveSelectedMarker_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#111827"
                            BorderBrush="#263244"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Diagnostics"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="ImageInfoText"
                                       Text="Image --"
                                       FontFamily="Consolas"/>
                            <TextBlock x:Name="PanZoomText"
                                       Text="Zoom 1.00 / Pan (0, 0)"
                                       FontFamily="Consolas"/>
                            <TextBlock x:Name="LastCommandText"
                                       Text="Last command --"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Background="#111827"
                BorderBrush="#263244"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock x:Name="StatusText"
                       Text="Prototype 0.5 ready."
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
